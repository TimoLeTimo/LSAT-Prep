{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the operations the interface needs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-database-status",
    "allow-question-index",
    "allow-import-catalog",
    "allow-import-history",
    "allow-choose-package",
    "allow-package-bytes",
    "allow-reject-package",
    "allow-preview-package",
    "allow-cancel-import",
    "allow-confirm-import",
    "allow-unfinished-session",
    "allow-practice-session",
    "allow-create-session",
    "allow-select-answer",
    "allow-flag-question",
    "allow-add-question-time",
    "allow-set-session-position",
    "allow-submit-answer",
    "allow-finish-session",
    "allow-abandon-session",
    "allow-start-clock",
    "allow-save-clock",
    "allow-pause-clock"
  ]
}
